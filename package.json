{
  "name": "edutrack-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "EduTrack Enterprise SaaS ERP Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "build:api": "npm --prefix apps/api run build",
    "build:web": "npm --prefix apps/web run build",
    "type-check:api": "tsc --noEmit --project apps/api/tsconfig.json",
    "type-check:web": "tsc --noEmit --project apps/web/tsconfig.json",
    "type-check:mobile": "tsc --noEmit --project apps/mobile/tsconfig.json"
  }
}
